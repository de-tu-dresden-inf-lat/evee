#   Classes
############################

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Big> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Big>)

AnnotationAssertion(cd:constraint :Big ":hasWeight > 1000")
SubClassOf(:Big :MyDroneSize)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Drone> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Drone>)

SubClassOf(:Drone :MovingObject)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Foggy> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Foggy>)

SubClassOf(:Foggy :LowVisibility)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Human> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Human>)

SubClassOf(:Human :MovingObject)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#LowVisibility> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#LowVisibility>)

DisjointClasses(:LowVisibility :Object)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#MovingObject> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#MovingObject>)

SubClassOf(:MovingObject :Object)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#MyObj0> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#MyObj0>)

EquivalentClasses(:MyObj0 ObjectIntersectionOf(:Obj0-d :Obj0-e0 :Obj0-e1 :Obj0-e2 :Obj0-e3 :Tree ObjectSomeValuesFrom(:environment :Snowy) ObjectSomeValuesFrom(:nearme :MyWeight)))
SubClassOf(:MyObj0 :ABoxConstraints)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#MyWeight> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#MyWeight>)

AnnotationAssertion(cd:constraint :MyWeight ":hasWeight = 853")

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-d> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-d>)

AnnotationAssertion(cd:constraint :Obj0-d ":distance = 14")
SubClassOf(:Obj0-d :ABoxConstraints)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-e0> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-e0>)

AnnotationAssertion(cd:constraint :Obj0-e0 ":epsilon0 = 13")
SubClassOf(:Obj0-e0 :ABoxConstraints)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-e1> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-e1>)

AnnotationAssertion(cd:constraint :Obj0-e1 ":epsilon1 = 11")
SubClassOf(:Obj0-e1 :ABoxConstraints)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-e2> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-e2>)

AnnotationAssertion(cd:constraint :Obj0-e2 ":epsilon2 = 12")
SubClassOf(:Obj0-e2 :ABoxConstraints)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-e3> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Obj0-e3>)

AnnotationAssertion(cd:constraint :Obj0-e3 ":epsilon3 = 9")
SubClassOf(:Obj0-e3 :ABoxConstraints)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistBig> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistBig>)

AnnotationAssertion(cd:constraint :OpDistBig ":epsilon0 + 3 = :distance")
SubClassOf(:OpDistBig :ConstraintsOfPresence)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistLowVisBig> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistLowVisBig>)

AnnotationAssertion(cd:constraint :OpDistLowVisBig ":epsilon1 + 5 = :distance")
SubClassOf(:OpDistLowVisBig :ConstraintsOfPresence)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistLowVisSmall> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistLowVisSmall>)

AnnotationAssertion(cd:constraint :OpDistLowVisSmall ":epsilon1 + 3 = :distance")
SubClassOf(:OpDistLowVisSmall :ConstraintsOfPresence)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistMovObjBig> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistMovObjBig>)

AnnotationAssertion(cd:constraint :OpDistMovObjBig ":epsilon2 + 4 = :distance")
SubClassOf(:OpDistMovObjBig :ConstraintsOfPresence)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistMovObjLowVisBig> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistMovObjLowVisBig>)

AnnotationAssertion(cd:constraint :OpDistMovObjLowVisBig ":epsilon3 + 7 = :distance")
SubClassOf(:OpDistMovObjLowVisBig :ConstraintsOfPresence)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistMovObjLowVisSmall> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistMovObjLowVisSmall>)

AnnotationAssertion(cd:constraint :OpDistMovObjLowVisSmall ":epsilon3 + 5 = :distance")
SubClassOf(:OpDistMovObjLowVisSmall :ConstraintsOfPresence)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistMovObjSmall> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistMovObjSmall>)

AnnotationAssertion(cd:constraint :OpDistMovObjSmall ":epsilon2 + 2 = :distance")
SubClassOf(:OpDistMovObjSmall :ConstraintsOfPresence)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistSmall> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#OpDistSmall>)

AnnotationAssertion(cd:constraint :OpDistSmall ":epsilon0 + 1 = :distance")
SubClassOf(:OpDistSmall :ConstraintsOfPresence)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Rainy> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Rainy>)

SubClassOf(:Rainy :LowVisibility)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#SafeOpDist> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#SafeOpDist>)

AnnotationAssertion(cd:constraint :SafeOpDist ":epsilon0 > 0")
SubClassOf(:SafeOpDist :SafeDistances)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#SafeOpDistLowVis> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#SafeOpDistLowVis>)

AnnotationAssertion(cd:constraint :SafeOpDistLowVis ":epsilon1 > 0")
SubClassOf(:SafeOpDistLowVis :SafeDistances)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#SafeOpDistMovObj> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#SafeOpDistMovObj>)

AnnotationAssertion(cd:constraint :SafeOpDistMovObj ":epsilon2 > 0")
SubClassOf(:SafeOpDistMovObj :SafeDistances)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#SafeOpDistMovObjLowVis> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#SafeOpDistMovObjLowVis>)

AnnotationAssertion(cd:constraint :SafeOpDistMovObjLowVis ":epsilon3 > 0")
SubClassOf(:SafeOpDistMovObjLowVis :SafeDistances)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Small> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Small>)

AnnotationAssertion(cd:constraint :Small ":hasWeight > 100")
SubClassOf(:Small :MyDroneSize)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Snowy> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Snowy>)

SubClassOf(:Snowy :LowVisibility)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#StaticObject> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#StaticObject>)

SubClassOf(:StaticObject :Object)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Tree> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#Tree>)

SubClassOf(:Tree :StaticObject)

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#WetDrone> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#WetDrone>)

SubClassOf(:WetDrone :Drone)
SubClassOf(:WetDrone ObjectSomeValuesFrom(:environment :LowVisibility))

# Class: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#World> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#World>)

SubClassOf(:World ObjectSomeValuesFrom(:exists :MyObj0))


############################
#   Named Individuals
############################

# Individual: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#o0> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#o0>)

ClassAssertion(:MyObj0 :o0)


SubClassOf(ObjectIntersectionOf(:MovingObject :OpDistMovObjBig :SafeOpDistMovObj ObjectSomeValuesFrom(:environment :Sunny) ObjectSomeValuesFrom(:nearme :Big)) :SafeBig)
SubClassOf(ObjectIntersectionOf(:MovingObject :OpDistMovObjLowVisBig :SafeOpDistMovObjLowVis ObjectSomeValuesFrom(:environment :LowVisibility) ObjectSomeValuesFrom(:nearme :Big)) :SafeBig)
SubClassOf(ObjectIntersectionOf(:MovingObject :OpDistMovObjLowVisSmall :SafeOpDistMovObjLowVis ObjectSomeValuesFrom(:environment :LowVisibility) ObjectSomeValuesFrom(:nearme :Small)) :SafeSmall)
SubClassOf(ObjectIntersectionOf(:MovingObject :OpDistMovObjSmall :SafeOpDistMovObj ObjectSomeValuesFrom(:environment :Sunny) ObjectSomeValuesFrom(:nearme :Small)) :SafeSmall)
SubClassOf(ObjectIntersectionOf(:OpDistBig :SafeOpDist :Tree ObjectSomeValuesFrom(:environment :Sunny) ObjectSomeValuesFrom(:nearme :Big)) :SafeBig)
SubClassOf(ObjectIntersectionOf(:OpDistLowVisBig :SafeOpDistLowVis :Tree ObjectSomeValuesFrom(:environment :LowVisibility) ObjectSomeValuesFrom(:nearme :Big)) :SafeBig)
SubClassOf(ObjectIntersectionOf(:OpDistLowVisSmall :SafeOpDistLowVis :Tree ObjectSomeValuesFrom(:environment :LowVisibility) ObjectSomeValuesFrom(:nearme :Small)) :SafeSmall)
SubClassOf(ObjectIntersectionOf(:OpDistSmall :SafeOpDist :Tree ObjectSomeValuesFrom(:environment :Sunny) ObjectSomeValuesFrom(:nearme :Small)) :SafeSmall)
SubClassOf(ObjectSomeValuesFrom(:exists ObjectIntersectionOf(:MyObj0 :SafeSmall)) :PartiallySafe)
)