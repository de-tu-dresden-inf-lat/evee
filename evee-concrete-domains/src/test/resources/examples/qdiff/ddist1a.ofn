# Data Property: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#distance> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#distance>)

DataPropertyDomain(:distance :Object)
DataPropertyRange(:distance owl:real)

# Data Property: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#epsilon0> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#epsilon0>)

DataPropertyDomain(:epsilon0 :Object)
DataPropertyRange(:epsilon0 owl:real)

# Data Property: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#epsilon1> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#epsilon1>)

DataPropertyDomain(:epsilon1 :Object)
DataPropertyRange(:epsilon1 owl:real)

# Data Property: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#epsilon2> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#epsilon2>)

DataPropertyDomain(:epsilon2 :Object)
DataPropertyRange(:epsilon2 owl:real)

# Data Property: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#epsilon3> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#epsilon3>)

DataPropertyDomain(:epsilon3 :Object)
DataPropertyRange(:epsilon3 owl:real)

# Data Property: <http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#hasWeight> (<http://www.semanticweb.org/alisa/ontologies/2023/concrete-domain/drone-distance#hasWeight>)

DataPropertyDomain(:hasWeight :Object)
DataPropertyRange(:hasWeight owl:real)



